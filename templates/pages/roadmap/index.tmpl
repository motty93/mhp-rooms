{{ define "head" }}
<meta name="description" content="HuntersHubの開発ロードマップ。今後実装予定の機能や開発スケジュールをご覧いただけます。" />
<meta name="keywords" content="ロードマップ,開発予定,HuntersHub,ハンターズハブ,モンスターハンター,モンハン,新機能,今後の予定" />
<meta property="og:title" content="ロードマップ - HuntersHub" />
<meta property="og:description" content="HuntersHubの今後の開発予定と実装スケジュールをご確認いただけます" />
{{ end }}

{{ define "page" }}
<div class="container mx-auto px-4 py-8">
  <div class="max-w-6xl mx-auto">
    <!-- ページヘッダー -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-800 mb-4">開発ロードマップ</h1>
      <p class="text-gray-600">
        HuntersHubの今後の開発予定をご紹介します。実装時期や内容は変更される場合があります。<br />
        <a href="/info" class="text-blue-600 hover:underline">最新の更新情報はこちら</a>
      </p>
    </div>

    <!-- ロードマップアイテム一覧 -->
    <div class="grid gap-6 md:grid-cols-2">
      {{ if .PageData.Roadmaps }}
      {{ range .PageData.Roadmaps }}
      <a href="/roadmap/{{ .Slug }}" class="block bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md hover:border-blue-300 transition-all cursor-pointer">
        <div class="mb-3">
          {{ if eq .Status "planned" }}
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-700">
            予定
          </span>
          {{ else if eq .Status "in_progress" }}
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
            開発中
          </span>
          {{ else if eq .Status "completed" }}
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
            完了
          </span>
          {{ end }}
        </div>
        <h2 class="text-xl font-bold text-gray-800 mb-2">{{ .Title }}</h2>
        <p class="text-gray-600 mb-4">{{ .Summary }}</p>
        <span class="inline-flex items-center text-blue-600 text-sm font-medium">
          詳細を見る
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
      </a>
      {{ end }}
      {{ else }}
      <div class="col-span-2 bg-blue-50 border border-blue-200 rounded-lg p-8 text-center">
        <p class="text-gray-600">現在、ロードマップはありません。</p>
      </div>
      {{ end }}
    </div>

    <!-- フィードバック -->
    <div class="mt-12 bg-gray-50 rounded-lg p-8 text-center">
      <h2 class="text-xl font-bold text-gray-800 mb-4">
        ご要望・ご意見をお聞かせください
      </h2>
      <p class="text-gray-600 mb-6">
        追加してほしい機能や改善のアイデアがありましたら、ぜひお聞かせください。<br />
        皆様からのフィードバックを参考に、より良いサービスを目指します。
      </p>
      <a href="/contact"
        class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors">
        お問い合わせ
      </a>
    </div>
  </div>
</div>
{{ end }}
