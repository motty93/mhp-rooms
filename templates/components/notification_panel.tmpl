{{ define "notification_panel" }}
  <!-- お知らせパネル（ヘッダーのベル / モバイルメニューから開く。ページ内に 1 つだけ配置） -->
  <div x-data @keydown.escape.window="$store.notifications.close()">
    <!-- 背景（クリックで閉じる） -->
    <div
      x-show="$store.notifications.open"
      x-cloak
      @click="$store.notifications.close()"
      class="fixed inset-0 z-[60]"
    ></div>

    <div
      x-show="$store.notifications.open"
      x-cloak
      x-transition:enter="transition ease-out duration-150"
      x-transition:enter-start="opacity-0 -translate-y-1"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-100"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed top-16 left-0 right-0 md:left-auto md:right-4 md:w-96 z-[61] bg-white border border-gray-200 shadow-xl md:rounded-lg flex flex-col max-h-[calc(100vh-5rem)]"
      role="dialog"
      aria-label="お知らせ"
    >
      <!-- ヘッダー -->
      <div
        class="flex items-center justify-between px-4 py-3 border-b border-gray-200"
      >
        <h2 class="text-base font-bold text-gray-800">お知らせ</h2>
        <div class="flex items-center gap-3">
          <a
            href="/info"
            class="text-xs text-blue-600 hover:underline"
            @click="$store.notifications.close()"
            >更新情報一覧</a
          >
          <button
            type="button"
            @click="$store.notifications.close()"
            class="text-gray-400 hover:text-gray-600 transition-colors"
            aria-label="閉じる"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
      </div>

      <!-- 本文 -->
      <div class="overflow-y-auto">
        <!-- 読み込み中 -->
        <div
          x-show="$store.notifications.loading && !$store.notifications.loaded"
          class="px-4 py-8 text-center text-sm text-gray-500"
        >
          読み込み中...
        </div>

        <!-- エラー -->
        <div
          x-show="$store.notifications.error && !$store.notifications.loading"
          x-cloak
          class="px-4 py-8 text-center text-sm text-red-600"
          x-text="$store.notifications.error"
        ></div>

        <!-- 空 -->
        <div
          x-show="$store.notifications.loaded && !$store.notifications.error && $store.notifications.items.length === 0"
          x-cloak
          class="px-4 py-8 text-center text-sm text-gray-500"
        >
          お知らせはまだありません
        </div>

        <!-- 一覧 -->
        <template x-for="item in $store.notifications.items" :key="item.id">
          <a
            :href="item.link_url || '#'"
            @click="$store.notifications.close()"
            class="block px-4 py-3 border-b border-gray-100 hover:bg-gray-50 transition-colors"
            :class="{ 'bg-blue-50': item.unread }"
          >
            <div class="flex items-start gap-3">
              <!-- 未読マーク -->
              <span
                class="mt-1.5 w-2 h-2 rounded-full flex-shrink-0"
                :class="item.unread ? 'bg-blue-500' : 'bg-transparent'"
                aria-hidden="true"
              ></span>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <span
                    x-show="item.kind === 'info'"
                    class="text-[10px] font-semibold text-white bg-gray-700 px-1.5 py-0.5 rounded flex-shrink-0"
                    >更新情報</span
                  >
                  <p
                    class="text-sm font-medium text-gray-800 truncate"
                    x-text="item.title"
                  ></p>
                </div>
                <p
                  x-show="item.body"
                  class="mt-0.5 text-xs text-gray-500 line-clamp-2"
                  x-text="item.body"
                ></p>
                <p
                  class="mt-1 text-xs text-gray-400"
                  x-text="item.time_ago"
                ></p>
              </div>
            </div>
          </a>
        </template>
      </div>
    </div>
  </div>
{{ end }}
