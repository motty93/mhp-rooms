{{ define "profile_activity" }}
  <div>
    <h2 class="sr-only">最近の活動履歴</h2>
    <div class="space-y-4">
      {{ if .Activities }}
        {{ range .Activities }}
          <div
            class="bg-gray-50 p-4 rounded-lg flex justify-between items-center hover:bg-gray-100 transition-colors border border-gray-200"
          >
            <div class="flex items-center space-x-4">
              <i
                class="fa-solid {{ .Icon }} {{ .IconColor }}"
                aria-hidden="true"
              ></i>
              <div>
                <p class="font-semibold text-gray-800">{{ .Title }}</p>
                <p class="text-sm text-gray-500">{{ .Description }}</p>
              </div>
            </div>
            <span class="text-xs text-gray-400">{{ .TimeAgo }}</span>
          </div>
        {{ end }}
      {{ else }}
        <div class="flex min-h-[260px] items-center sm:min-h-[310px]">
          <div
            class="w-full rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center"
          >
            <div
              class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-gray-200 text-gray-600"
            >
              <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
            </div>
            <h3 class="font-semibold text-gray-800">
              まだ活動履歴がありません
            </h3>
            <p class="mt-1 text-sm leading-6 text-gray-500">
              部屋の作成や参加などの活動があるとここに表示されます。
            </p>
          </div>
        </div>
      {{ end }}
    </div>
    {{ template "tab_pagination" .Pagination }}
  </div>
{{ end }}
