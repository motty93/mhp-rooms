{{ define "profile_activity" }}
  <div>
    <h2 class="sr-only">最近の活動履歴</h2>
    {{ if .Activities }}
      <ul class="divide-y divide-gray-200">
        {{ range .Activities }}
          <li class="flex items-start gap-3.5 px-1 py-4">
            <div
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-indigo-50"
              aria-hidden="true"
            >
              <i class="fa-solid {{ .Icon }} {{ .IconColor }}"></i>
            </div>
            <div class="min-w-0 flex-1">
              <p class="break-words text-sm font-semibold text-gray-800">
                {{ .Title }}
              </p>
              {{ if .Description }}
                <p class="mt-0.5 break-words text-sm text-gray-600">
                  {{ .Description }}
                </p>
              {{ end }}
              <p class="mt-1 text-xs text-gray-500">{{ .TimeAgo }}</p>
            </div>
          </li>
        {{ end }}
      </ul>
    {{ else }}
      <div class="flex min-h-[448px] items-center sm:min-h-[584px]">
        <div
          class="w-full rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center"
        >
          <div
            class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-gray-200 text-gray-600"
          >
            <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
          </div>
          <h3 class="font-semibold text-gray-800">まだ活動履歴がありません</h3>
          <p class="mt-1 text-sm leading-6 text-gray-500">
            部屋の作成や参加などの活動があるとここに表示されます。
          </p>
        </div>
      </div>
    {{ end }}
    {{ template "tab_pagination" .Pagination }}
  </div>
{{ end }}
