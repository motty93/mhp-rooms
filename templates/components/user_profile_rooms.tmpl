{{ define "user_profile_rooms" }}
  <div>
    <h2 class="sr-only">作成した部屋</h2>
    {{ if .Rooms }}
      <div class="space-y-4">
        {{ range .Rooms }}
          <article
            class="rounded-xl border border-gray-200 bg-gray-50 p-4 sm:p-5"
          >
            <div class="mb-2 flex items-start justify-between gap-4">
              <h3 class="break-words font-semibold text-gray-800">
                {{ .Name }}
              </h3>
              <span class="text-xs text-gray-500">{{ .CreatedAt }}</span>
            </div>
            {{ if .Description }}
              <p class="mb-3 break-words text-sm leading-6 text-gray-600">
                {{ .Description }}
              </p>
            {{ end }}
            <div
              class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
            >
              <div
                class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-500"
              >
                <span>{{ .GameVersion }}</span>
                <span>{{ .PlayerCount }}</span>
                <span class="{{ .StatusColor }}">{{ .Status }}</span>
              </div>
              {{ if .IsClickable }}
                <button
                  type="button"
                  onclick="if (window.userProfileRoomsHandler) { window.userProfileRoomsHandler.openRoomModal('{{ .ID }}', '{{ .Name }}', '{{ .Description }}', '{{ .GameVersion }}', '{{ .PlayerCount }}', '{{ .Status }}'); }"
                  class="min-h-11 cursor-pointer rounded-lg bg-gray-800 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-gray-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2"
                >
                  参加する
                </button>
              {{ else }}
                <span class="text-xs text-gray-500 italic">参加不可</span>
              {{ end }}
            </div>
            {{ if .StatusNote }}
              <p class="mt-2 text-xs text-orange-600">
                <i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i
                >{{ .StatusNote }}
              </p>
            {{ end }}
          </article>
        {{ end }}
      </div>
      {{ template "tab_pagination" .Pagination }}
    {{ else }}
      <div class="flex min-h-[448px] items-center sm:min-h-[584px]">
        <div
          class="grid w-full gap-4 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-5 text-center sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-center sm:text-left"
        >
          <div
            class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-gray-200 text-gray-600 sm:mx-0"
          >
            <i class="fa-solid fa-door-open" aria-hidden="true"></i>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800">
              作成した部屋はまだありません
            </h3>
            <p class="mt-1 text-sm leading-6 text-gray-500">
              このハンターが部屋を作成すると、ここに表示されます。
            </p>
          </div>
          <a
            href="/rooms"
            class="inline-flex min-h-11 items-center justify-center gap-2 font-semibold text-indigo-700 hover:text-indigo-900 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2"
          >
            部屋一覧を見る
            <i class="fa-solid fa-chevron-right text-xs" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    {{ end }}
  </div>
{{ end }}
