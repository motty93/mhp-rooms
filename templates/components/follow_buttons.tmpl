{{ define "follow_buttons" }}
  {{ if and .IsAuthenticated (not .IsOwnProfile) }}
    {{ if eq .RelationStatus "none" }}
      <div class="w-full sm:w-auto">
        <button
          hx-post="/api/users/{{ .User.ID }}/follow"
          hx-target="#profile-card-content"
          hx-swap="innerHTML"
          class="flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-gray-700 px-5 py-2.5 font-bold text-white transition-colors duration-200 hover:bg-gray-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 sm:w-auto"
        >
          <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
          <span>フォローする</span>
        </button>
      </div>
    {{ else if eq .RelationStatus "following" }}
      <div class="w-full sm:w-auto">
        <button
          onclick="showUnfollowModal('{{ .User.ID }}', '{{ jsEscape (profileDisplayName .User) }}')"
          class="flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-gray-200 px-5 py-2.5 font-bold text-gray-800 transition-colors duration-200 hover:bg-gray-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 sm:w-auto"
        >
          <i class="fa-solid fa-user-check" aria-hidden="true"></i>
          <span>フォロー中</span>
        </button>
      </div>
    {{ else if eq .RelationStatus "follower" }}
      <div class="w-full sm:w-auto">
        <button
          hx-post="/api/users/{{ .User.ID }}/follow"
          hx-target="#profile-card-content"
          hx-swap="innerHTML"
          class="flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-gray-700 px-5 py-2.5 font-bold text-white transition-colors duration-200 hover:bg-gray-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2 sm:w-auto"
        >
          <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
          <span>フォローバックする</span>
        </button>
      </div>
    {{ else if eq .RelationStatus "mutual" }}
      <div class="w-full space-y-2 sm:w-auto">
        <div class="text-center">
          <span
            class="inline-block bg-green-100 text-green-800 text-sm px-3 py-1 rounded-full mb-2"
          >
            <i class="fa-solid fa-users" aria-hidden="true"></i> フレンド
          </span>
        </div>
        <button
          onclick="showUnfollowModal('{{ .User.ID }}', '{{ jsEscape (profileDisplayName .User) }}', true)"
          class="flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-lg bg-red-600 px-5 py-2.5 font-bold text-white transition-colors duration-200 hover:bg-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 sm:w-auto"
        >
          <i class="fa-solid fa-user-minus" aria-hidden="true"></i>
          <span>フレンド解除</span>
        </button>
      </div>
    {{ end }}
  {{ end }}
{{ end }}
