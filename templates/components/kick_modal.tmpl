<!-- キック確認モーダル（ホストのみ） -->
<div
  x-show="showKickModal"
  x-cloak
  class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  @click.self="closeKickModal()"
  @keydown.escape.window="closeKickModal()"
>
  <div
    class="bg-white rounded-lg max-w-md w-full"
    role="dialog"
    aria-modal="true"
    aria-labelledby="kick-modal-title"
    @click.stop=""
  >
    <div class="p-6 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h2 id="kick-modal-title" class="text-xl font-bold text-gray-800">
          <svg
            class="w-5 h-5 text-red-600 mr-2 inline-block align-text-bottom"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6"
            /></svg
          >メンバーを退出させる
        </h2>
        <button
          type="button"
          @click="closeKickModal()"
          class="text-gray-400 hover:text-gray-600 transition-colors"
          aria-label="閉じる"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </div>
    </div>

    <div class="p-6 space-y-4">
      <template x-if="kickTarget">
        <div
          class="flex items-center space-x-3 p-3 bg-gray-50 rounded border border-gray-200"
        >
          <img
            :src="kickTarget.avatar_url || '/static/images/default-avatar.webp'"
            class="w-10 h-10 rounded-full object-cover"
            :alt="kickTarget.display_name + 'のアバター'"
          />
          <span
            class="text-gray-800 font-medium"
            x-text="kickTarget.display_name"
          ></span>
        </div>
      </template>
      <p class="text-sm text-gray-700">
        このユーザーを部屋から退出させますか？
      </p>
      <p
        class="text-sm text-red-600 bg-red-50 border border-red-200 rounded p-3"
      >
        <svg
          class="w-4 h-4 mr-1 inline-block align-text-bottom"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          />
        </svg>
        退出させたユーザーは、この部屋に再度参加できなくなります。
      </p>
      <p
        x-show="kickError"
        x-cloak
        class="text-sm text-red-600"
        x-text="kickError"
      ></p>
    </div>

    <div class="p-6 border-t border-gray-200 flex justify-end space-x-3">
      <button
        type="button"
        @click="closeKickModal()"
        :disabled="isKicking"
        class="px-4 py-2 text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors disabled:opacity-50"
      >
        キャンセル
      </button>
      <button
        type="button"
        @click="confirmKick()"
        :disabled="isKicking"
        class="px-4 py-2 text-white bg-red-600 rounded-md hover:bg-red-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span x-show="!isKicking">退出させる</span>
        <span x-show="isKicking" x-cloak
          ><svg
            class="animate-spin inline-block w-4 h-4 mr-1"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
            ></path></svg
          >処理中...</span
        >
      </button>
    </div>
  </div>
</div>
