{{ define "recent_activity_feed" }}
  <section
    class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6"
    aria-labelledby="recent-activity-title"
  >
    <div class="border-b border-gray-100 pb-4">
      <div>
        <h2 id="recent-activity-title" class="text-lg font-bold text-gray-800">
          最近のうごき
        </h2>
        <p class="mt-1 text-sm text-gray-600">
          今週は {{ .WeeklyRoomCount }} 件の部屋が作成されました。
        </p>
      </div>
    </div>
    {{ if .Activities }}
      <ul class="divide-y divide-gray-100" aria-label="最近の公開活動">
        {{ range .Activities }}
          <li class="flex gap-3 py-4">
            <div class="relative mt-0.5 h-10 w-10 shrink-0">
              {{ if .AvatarURL }}
                <img
                  src="{{ stringPtr .AvatarURL }}"
                  alt="{{ .DisplayName }} のアバター"
                  width="40"
                  height="40"
                  loading="lazy"
                  class="h-10 w-10 rounded-full object-cover"
                />
              {{ else }}
                <img
                  src="/static/images/default-avatar.webp"
                  alt="{{ .DisplayName }} のデフォルトアバター"
                  width="40"
                  height="40"
                  loading="lazy"
                  class="h-10 w-10 rounded-full object-cover"
                />
              {{ end }}
              <span
                class="absolute -bottom-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full border-2 border-white {{ if eq .Type "room_create" }}
                  bg-blue-100 text-blue-700
                {{ else if eq .Type "room_join" }}
                  bg-green-100 text-green-700
                {{ else }}
                  bg-amber-100 text-amber-700
                {{ end }}"
                aria-hidden="true"
              >
                {{ if eq .Type "room_create" }}
                  <svg
                    class="h-3 w-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 4v16m8-8H4"
                    />
                  </svg>
                {{ else if eq .Type "room_join" }}
                  <svg
                    class="h-3 w-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2m17-10a4 4 0 110-8 4 4 0 010 8z"
                    />
                  </svg>
                {{ else }}
                  <svg
                    class="h-3 w-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 4v16m8-8H4"
                    />
                  </svg>
                {{ end }}
              </span>
            </div>
            <div class="min-w-0">
              <p class="text-sm text-gray-700">
                <a
                  href="/users/{{ .UserID }}"
                  class="font-semibold text-gray-900 hover:underline focus:outline-none focus:ring-2 focus:ring-gray-700 focus:ring-offset-2"
                  >{{ .DisplayName }}</a
                >
                さんが{{ if eq .Type "room_create" }}
                  部屋を作成しました
                {{ else if eq .Type "room_join" }}
                  部屋に参加しました
                {{ else }}
                  登録しました
                {{ end }}。
              </p>
              <p class="mt-1 truncate text-sm text-gray-500">
                {{ .Title }}
                <span class="ml-1 text-gray-400">{{ .TimeAgo }}</span>
              </p>
            </div>
          </li>
        {{ end }}
      </ul>
    {{ else }}
      <p class="py-6 text-sm text-gray-500">
        まだ表示できる活動はありません。最初の部屋を作ってみましょう。
      </p>
    {{ end }}
  </section>
{{ end }}
